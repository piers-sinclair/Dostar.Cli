import { useMutation, useQueryClient, type UseMutationResult } from '@tanstack/react-query';
import { apiClient } from '@/shared/api/client';

// TODO: Update this path to match your backend module's endpoint.
// e.g. for a Payments module consumed here: '/api/v1/payments'
const {{ name_screaming }}_API_PATH = '/api/v1/{{ name_kebab }}';
const {{ name_screaming }}_QUERY_KEY = ['{{ name_kebab }}'] as const;

export function useCreate{{ name }}(): UseMutationResult<unknown, Error, unknown> {
    const client = useQueryClient();
    return useMutation<unknown, Error, unknown>({
        mutationFn: (req) => apiClient<unknown>({{ name_screaming }}_API_PATH, { method: 'POST', data: req }),
        onSuccess: () => client.invalidateQueries({ queryKey: {{ name_screaming }}_QUERY_KEY }),
    });
}
