import type { JSX } from 'react';
import { createFileRoute } from '@tanstack/react-router';
{{ if type == "list" -}}
import { {{ name }}List } from '@/features/{{ name_kebab }}/components/{{ name }}List';
{{ else if type == "form" -}}
import { {{ name }}Form } from '@/features/{{ name_kebab }}/components/{{ name }}Form';
{{ end -}}
export const Route = createFileRoute('/{{ name_kebab }}')({
    component: {{ name }}Page,
});

function {{ name }}Page(): JSX.Element {
    return (
        <div className="mx-auto max-w-lg space-y-6">
            {{ if type == "list" -}}
            <{{ name }}List />
            {{ else if type == "form" -}}
            <{{ name }}Form />
            {{ end -}}
        </div>
    );
}
