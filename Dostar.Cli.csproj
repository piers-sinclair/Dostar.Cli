<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dostar</ToolCommandName>
    <PackageId>Dostar.Cli</PackageId>
    <Version>0.1.0</Version> <!-- x-release-please-version -->
    <Description>Scaffold production-ready fullstack .NET + React projects with built-in Azure infrastructure, CI/CD pipelines, and DevSecOps practices baked in — so startups skip weeks of boilerplate and ship on day one.</Description>
    <Authors>Piers Sinclair</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/piers-sinclair/Dostar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/piers-sinclair/Dostar.Cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;cli;scaffold;startup;template;modular-monolith;azure;bicep;devsecops;cicd;fullstack;react;boilerplate</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.2.4" />
    <PackageReference Include="System.CommandLine" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\*.scriban" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dostar.Cli.Tests" />
  </ItemGroup>

</Project>
